{
  "serviceName": "user-service",
  "version": "1.0.0",
  "specification": {
    "openapi": "3.0.3",
    "info": {
      "title": "User Service API",
      "version": "1.0.0"
    },
    "paths": {
      "/users/{id}": {
        "get": {
          "responses": {
            "200": {
              "description": "User found",
              "content": {
                "application/json": {
                  "schema": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "integer"
                      },
                      "name": {
                        "type": "string"
                      },
                      "email": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
